SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./nexus.db
NEXUS_ADMIN_EMAIL=admin@holding.local
NEXUS_ADMIN_PASSWORD=changeme123
NEXUS_ENV=development

# ── Microsoft 365 (maily/kalendář přes Graph) ──────────────
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REFRESH_TOKEN=

# ── Webhooky (HMAC) ────────────────────────────────────────
# Prázdné = HMAC vypnuté. Nastav stejný tajný klíč i na gatewayi,
# která posílá /webhooks/* (podpis: X-Nexus-Signature: sha256=<hmac>).
WEBHOOK_SECRET=

# ── iDoklad (OAuth2 client_credentials) ────────────────────
IDOKLAD_CLIENT_ID=
IDOKLAD_CLIENT_SECRET=
IDOKLAD_SCOPE=idoklad_api

# ── MCP server klient (mcp/nexus_mcp.py) ───────────────────
# NEXUS_API_KEY vytvoříš přes: python scripts/nexus_token.py create ...
NEXUS_API_BASE=http://127.0.0.1:8000
NEXUS_API_KEY=
